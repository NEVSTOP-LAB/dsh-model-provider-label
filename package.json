{
  "name": "dsh-nevstop-lab-flavor",
  "version": "0.2.0",
  "description": "NEVSTOP-LAB 的 DSH 定制口味：输入区显示「供应商 · 模型」，编写器键位可配（Enter 换行 / Ctrl+Enter 发送 / Shift+Enter），设置页逐项开关，配置持久化到插件自己的 JSON。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nevstop-lab",
    "flavor",
    "model-selector",
    "composer-keys"
  ],
  "homepage": "https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor#readme",
  "bugs": {
    "url": "https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor.git"
  },
  "license": "MIT",
  "author": "NEVSTOP-LAB",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.0 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
