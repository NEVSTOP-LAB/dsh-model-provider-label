{
  "name": "dsh-nevstop-lab-flavor",
  "version": "0.3.0",
  "description": "让 DSH 更贴合 NEVSTOP-LAB 使用习惯的本地化定制插件，各项定制按需开启。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nevstop-lab",
    "flavor",
    "model-selector",
    "composer-keys"
  ],
  "homepage": "https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor#readme",
  "bugs": {
    "url": "https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEVSTOP-LAB/dsh-nevstop-lab-flavor.git"
  },
  "license": "MIT",
  "author": "NEVSTOP-LAB",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.0 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/balance/index.js && node --check lib/balance/config.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "~0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    }
  }
}
